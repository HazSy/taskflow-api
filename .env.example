# Copia este fichero a .env y ajusta los valores
NODE_ENV=development
PORT=3000

# SQLite en desarrollo. En producción: postgresql://user:pass@host:5432/taskflow
DATABASE_URL="file:./dev.db"

# Clave para firmar los JWT (mínimo 16 caracteres, cámbiala siempre)
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=1h

# Orígenes permitidos separados por comas, o * en desarrollo
CORS_ORIGIN=*
